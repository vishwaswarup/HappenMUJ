# Leave VITE_API_BASE_URL empty to use the built-in sample data (no backend needed).
# Set it to /api to use the real FastAPI backend through the Vite dev proxy (the backend serves /api and /api/v1):
#   VITE_API_BASE_URL=/api
#   VITE_API_BASE_URL=http://localhost:8000/api      (direct, no proxy; needs CORS_ORIGINS on the backend)
VITE_API_BASE_URL=

# Dev proxy target for /api. Default http://localhost:8000
VITE_PROXY_TARGET=http://localhost:8000
