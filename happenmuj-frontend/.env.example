# Leave VITE_API_BASE_URL empty to use the built-in sample data (no backend needed).
# Set it to your FastAPI base to use the real API, for example:
#   VITE_API_BASE_URL=/api/v1            (with the Vite dev proxy)
#   VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=

# Dev proxy target for /api when VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://localhost:8000
