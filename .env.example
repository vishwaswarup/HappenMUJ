MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
DB_NAME=happenmuj
JWT_SECRET=change-me-in-production-use-32+-bytes
JWT_EXPIRE_MINUTES=1440
# Comma-separated sign-up allow-list; empty = allow any email (dev). Production example: jaipur.manipal.edu
ALLOWED_EMAIL_DOMAINS=
PLATFORM_ADMIN_EMAIL=admin@muj-demo.edu
PLATFORM_ADMIN_PASSWORD=demo1234
APP_TIMEZONE=Asia/Kolkata
# Comma-separated; the Vite dev server is http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Google sign-in: OAuth "Web application" client id from console.cloud.google.com (empty = Google sign-in off)
GOOGLE_CLIENT_ID=

# --- Deployment (see TASKS.md) ---
# APP_ENV=production makes the API refuse to start with the placeholder JWT_SECRET / admin password / localhost CORS.
APP_ENV=development
# Sign-in / sign-up / Google attempts allowed per client per minute (0 = unlimited).
RATE_LIMIT_AUTH=20
# true behind a reverse proxy (Render, Railway) so the limiter sees the real client address.
TRUST_PROXY_HEADERS=false
# Atlas example: MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
